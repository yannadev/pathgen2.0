{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathgen.local/schemas/lesson.schema.json",
  "type": "object",
  "required": ["schema_version", "lesson", "questions", "question_sets"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "lesson": {
      "type": "object",
      "required": ["code", "slug", "lesson_order", "title", "summary", "content_schema_version", "skill_codes", "content", "is_published"],
      "additionalProperties": false,
      "properties": {
        "code": {"pattern": "^L[1-3]$"}, "slug": {"type": "string", "minLength": 1},
        "lesson_order": {"type": "integer", "minimum": 1, "maximum": 3},
        "title": {"type": "string", "minLength": 1}, "summary": {"type": "string", "minLength": 1},
        "content_schema_version": {"const": 1},
        "skill_codes": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"pattern": "^S[1-6]$"}},
        "content": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["type"]}},
        "is_published": {"const": true}
      }
    },
    "questions": {"type": "array", "minItems": 30, "maxItems": 30, "items": {"$ref": "https://pathgen.local/schemas/common.schema.json#/$defs/question"}},
    "question_sets": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "https://pathgen.local/schemas/common.schema.json#/$defs/question_set"}}
  }
}
